diff -uNr pi-hole.orig/advanced/Templates/logrotate pi-hole/advanced/Templates/logrotate
--- pi-hole.orig/advanced/Templates/logrotate
+++ pi-hole/advanced/Templates/logrotate
@@ -1,14 +1,14 @@
 /var/log/pihole/pihole.log {
-    # su #
+    su root pihole
     daily
     create 640 pihole pihole
-    rotate 5
+    rotate 31
     compress
-    delaycompress
     notifempty
     nomail
+    dateext
     postrotate
         kill -USR2 $(cat /run/pihole-FTL.pid 2>/dev/null) 2>/dev/null || true
     endscript
 }

 # FTL.log and webserver.log are opened and closed for each line, therefore no postrotate is needed
-/var/log/pihole/FTL.log {
-    # su #
-    weekly
+/var/log/pihole/FTL.log /var/log/pihole/pihole-FTL.log {
+    su root pihole
+    daily
     create 640 pihole pihole
-    rotate 3
+    rotate 31
     compress
-    delaycompress
     notifempty
     nomail
+    dateext
 }

 /var/log/pihole/webserver.log {
-    # su #
-    weekly
+    su root pihole
+    daily
     create 640 pihole pihole
-    rotate 3
+    rotate 31
     compress
-    delaycompress
     notifempty
     nomail
+    dateext
 }
